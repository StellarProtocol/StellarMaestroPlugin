<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(MSBuildThisFileDirectory)Local.props" Condition="Exists('$(MSBuildThisFileDirectory)Local.props')" />

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS8632;CS8765</NoWarn>
    <RootNamespace>Stellar.Maestro</RootNamespace>
    <AssemblyName>Stellar.Maestro</AssemblyName>
    <Version>2.4.1</Version>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- Developer note-timing / sync diagnostics (Band-Instrument-Playback.md, "sweep"): DEBUG builds only. They poll a
       file-command channel in the world-writable C:\Users\Public\maestro-link-spike\ folder, so a release must not
       contain them. Their call sites are C# partial methods (declared in Plugin.cs / MidiPlayer.Net.cs), which the
       compiler drops, arguments and all, when no implementation is compiled. tools/link-spike/ is never compiled or packed. -->
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="LinkSpikeDiagPatch.cs" />
    <Compile Remove="MidiPlayer.Diag.cs" />
    <Compile Remove="Plugin.LinkDiag.cs" />
    <Compile Remove="Plugin.SweepCmd.cs" />
  </ItemGroup>

  <!-- The unit-test project lives under tests/ with its own csproj; keep its sources (and its obj/ generated files) out
       of the plugin assembly. -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- i18n P2: consumes IPluginServices.Localization (framework 2.1.0). House-style UI (BubbleElement.FillColorFn,
         SelectableElement.Bare, TextElement.Ellipsize) needs 2.26+; pinned to 2.28.1 with the Link players panel. -->
    <!-- 2.29.0-local.ddradius.1 = framework PR #148 (DropdownElement.CornerRadius), from the workspace local feed
         (nuget.config). TEMPORARY: switch to 2.29.0 once it is released, and drop the local feed. -->
    <PackageReference Include="Stellar.Abstractions" Version="2.29.0-local.ddradius.1" />
    <PackageReference Include="Stellar.Plugin.InteropRefs" Version="2.29.0-local.ddradius.1" />
  </ItemGroup>

  <!-- Launcher-tile icon (read by LogicalName) + localization catalogs. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources/maestro-icon.png" LogicalName="Stellar.Maestro.maestro-icon.png" />
    <!-- "Reset to default" glyph used by the compact ↺ buttons on the Settings/Network sliders. -->
    <EmbeddedResource Include="Resources/icon_reset.png" LogicalName="Stellar.Maestro.icon_reset.png" />
    <!-- Main-window hub-card icons (drawn by tools/make-hub-icons.py). -->
    <EmbeddedResource Include="Resources/icon-library.png" LogicalName="Stellar.Maestro.icon-library.png" />
    <EmbeddedResource Include="Resources/icon-link.png" LogicalName="Stellar.Maestro.icon-link.png" />
    <EmbeddedResource Include="Resources/icon-preview.png" LogicalName="Stellar.Maestro.icon-preview.png" />
    <EmbeddedResource Include="Resources/icon-settings.png" LogicalName="Stellar.Maestro.icon-settings.png" />
    <EmbeddedResource Include="Lang/en.json" LogicalName="Stellar.Maestro.Lang.en.json" />
    <EmbeddedResource Include="Lang/ja.json" LogicalName="Stellar.Maestro.Lang.ja.json" />
    <EmbeddedResource Include="Lang/th.json" LogicalName="Stellar.Maestro.Lang.th.json" />
    <EmbeddedResource Include="Lang/id.json" LogicalName="Stellar.Maestro.Lang.id.json" />
    <EmbeddedResource Include="Lang/fil.json" LogicalName="Stellar.Maestro.Lang.fil.json" />
    <EmbeddedResource Include="Lang/ko.json" LogicalName="Stellar.Maestro.Lang.ko.json" />
  </ItemGroup>
</Project>
